{
  "manifest_version": 3,
  "name": "HDRezka Downloader",
  "version": "0.3.0",
  "description": "Скачивание видео с rezka.fi в один клик: с названием, озвучкой, сезоном/серией и выбором качества",
  "permissions": ["downloads", "scripting"],
  "host_permissions": ["https://rezka.fi/*", "https://*.rezka.fi/*"],
  "content_scripts": [
    {
      "matches": ["https://rezka.fi/*", "https://*.rezka.fi/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Скачать видео",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  }
}
