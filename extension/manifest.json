{
  "manifest_version": 3,
  "name": "HDRezka Downloader",
  "version": "0.2.0",
  "description": "Скачивание видео с rezka.fi в один клик: с названием, озвучкой, сезоном/серией и выбором качества",
  "permissions": ["downloads", "scripting"],
  "host_permissions": ["https://rezka.fi/*", "https://*.rezka.fi/*"],
  "content_scripts": [
    {
      "matches": ["https://rezka.fi/*", "https://*.rezka.fi/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": { "default_title": "Скачать видео", "default_popup": "popup.html" }
}
